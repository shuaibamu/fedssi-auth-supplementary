    (∃ #j.
      ((HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ #i2.
          (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i2) ∧ (¬(#i2 = #i)))))"
