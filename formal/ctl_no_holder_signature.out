lemma P3_credential_issued_to_presenter:
  all-traces
  "∀ V did pk I C sid S D ch #i.
    (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ⇒
    (∃ #j. (Issued( I, h(pk), C ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V did pk I C sid S D ch #i.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i)
 ∧
  ∀ #j. (Issued( I, h(pk), C ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( St_V( $V, did, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_1
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( did, pk ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( h(pk(~skH)) ) @ #vk.10 )
          case H_Present
          solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                               <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                 ) @ #vk.15 )
            case H_Present
            by contradiction /* from formulas */
          next
            case c_proofGen
            solve( !KU( bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) ) @ #vk.28 )
              case Issue_After_Possession_Proof
              by contradiction /* from formulas */
            next
              case Issue_To_Honest_Holder
              by contradiction /* from formulas */
            next
              case c_bbsSign
              by solve( !KU( ~skI ) @ #vk.30 )
            qed
          qed
        next
          case c_h
          solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                               <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                 ) @ #vk.15 )
            case H_Present
            by contradiction /* from formulas */
          next
