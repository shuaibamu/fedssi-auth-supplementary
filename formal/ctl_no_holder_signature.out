theory FedSSI_Auth_Control_no_holder_signature begin

// Function signature and definition of the equational theory E

functions: bbsSign/2, fst/1, h/1, pair/2, pk/1, proofGen/3, pverify/4,
           sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    pverify(proofGen(bbsSign(sk, m), m, ph), pk(sk), m, ph) = true,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction UniqueDID:
  "∀ d k1 k2 #i #j.
    ((RegDID( d, k1 ) @ #i) ∧ (RegDID( d, k2 ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction NotAdversary:
  "∀ x #i. (HonestName( x ) @ #i) ⇒ (¬(x = 'M'))"
  // safety formula

rule (modulo E) Enrol_Holder:
   [ Fr( ~skH ) ]
  --[
  HonestHolder( $H, pk(~skH) ), RegDID( $H, pk(~skH) ), HonestName( $H )
  ]->
   [ !Holder( $H, ~skH ), !Registry( $H, pk(~skH) ), Out( pk(~skH) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_Adversary_DID:
   [ In( <$D, k> ) ] --[ RegDID( $D, k ) ]-> [ !Registry( $D, k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup_Issuer:
   [ Fr( ~skI ) ]
  --[ HonestName( $I ), HonestIssuer( $I ) ]->
   [ !IssuerKey( $I, ~skI ), !IssuerPub( $I, pk(~skI) ), Out( pk(~skI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Admin_Trusts_Issuer:
   [ !IssuerPub( $I, pkI ) ]
  --[ Trusted( $D, $I ) ]->
   [ !Trust( $D, $I, pkI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_To_Honest_Holder:
   [ !Holder( $H, ~skH ), !IssuerKey( $I, ~skI ) ]
  --[ Issued( $I, h(pk(~skH)), $C ) ]->
   [
   !HolderCred( $H, $I, $C, bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) ),
   Out( bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_After_Possession_Proof:
   [ !IssuerKey( $I, ~skI ), In( <pkM, sigPop> ) ]
  --[
  Eq( verify(sigPop, <'pop', $I, pkM>, pkM), true ),
  Issued( $I, h(pkM), $C )
  ]->
   [ Out( bbsSign(~skI, <'cred', h(pkM), $C, $I>) ) ]

  /*
  rule (modulo AC) Issue_After_Possession_Proof:
     [ !IssuerKey( $I, ~skI ), In( <pkM, sigPop> ) ]
    --[ Eq( z, true ), Issued( $I, h(pkM), $C ) ]->
     [ Out( bbsSign(~skI, <'cred', h(pkM), $C, $I>) ) ]
    variants (modulo AC)
    1. $I    = $I.9
       pkM   = pkM.11
       sigPop
             = sigPop.12
       z     = verify(sigPop.12, <'pop', $I.9, pkM.11>, pkM.11)
    
    2. $I    = $I.11
       pkM   = pk(x.19)
       sigPop
             = sign(<'pop', $I.11, pk(x.19)>, x.19)
       z     = true
  */

rule (modulo E) Setup_Verifier:
   [ Fr( ~skV ) ]
  --[ HonestName( $V ), HonestVerifier( $V ) ]->
   [ !VKey( $V, ~skV ), !VPub( $V, pk(~skV) ), Out( pk(~skV) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_From_Honest_Holder:
   [ Fr( ~ch ), !Holder( $H, skH ) ]
  --[ ChanOpen( ~ch, $H, $P ) ]->
   [ !ChanC( ~ch, $H, $P ), !ChanS( ~ch, $P ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_From_Adversary:
   [ Fr( ~ch ) ]
  --[ ChanOpen( ~ch, 'M', $P ) ]->
   [ !ChanS( ~ch, $P ), Out( ~ch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_Endpoint_Is_Adversary:
   [ !ChanC( ch, $H, 'M' ) ] --> [ Out( ch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_Start:
   [ !ChanC( ch, $H, $P ), !Holder( $H, skH ) ]
  --[ HStart( $H, ch, $P, $S, $D ) ]->
   [ St_H( $H, $S, $D, ch ), Out( <'req', $H, $S, $D> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) V_Challenge:
   [
   !VKey( $V, skV ), !ChanS( ch, $V ), In( <'req', did, $S, $D> ), Fr( ~n ),
   Fr( ~sid )
   ]
  --[ Challenge( $V, ~sid, ~n, ch ) ]->
   [ St_V( $V, did, $S, $D, ~n, ~sid, ch ), Out( <'chal', ~n, $V, ~sid> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_Present:
   [
   St_H( $H, $S, $D, ch ), !Holder( $H, skH ),
   !HolderCred( $H, $I, $C, cred ), In( <'chal', n, Vid, sid> )
   ]
  --[ HPresent( $H, pk(skH), Vid, sid, $S, $D, ch, $I, $C ) ]->
   [
   Out( <'pres', $H, <'cred', h(pk(skH)), $C, $I>, 
         proofGen(cred, <'cred', h(pk(skH)), $C, $I>,
                  h(<n, Vid, sid, $S, $D, ch>)), 
         'none'>
   )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) V_Verify:
   [
   St_V( $V, did, $S, $D, n, sid, ch ), !VKey( $V, skV ),
   !Registry( did, pkDoc ), !Trust( $D, $I, pkI ),
