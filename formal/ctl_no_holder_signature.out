lemma executable_accept:
  exists-trace
  "∃ V did pk I C sid S D ch #i #j.
    (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
    (HonestHolder( did, pk ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ V did pk I C sid S D ch #i #j.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
  (HonestHolder( did, pk ) @ #j)"
*/
simplify
solve( St_V( $V, $H, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_1
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( h(pk(~skH)) ) @ #vk.10 )
          case H_Present
          solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                               <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                 ) @ #vk.15 )
            case H_Present
            solve( !KU( ~n ) @ #vk.30 )
              case V_Challenge
              solve( !KU( ~sid ) @ #vk.33 )
                case V_Challenge
                SOLVED // trace found
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_relying_party:
  exists-trace
  "∃ V did D S sid cnf #i. RAccept( V, did, D, S, sid, cnf ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ V did D S sid cnf #i. (RAccept( V, did, D, S, sid, cnf ) @ #i)"
*/
simplify
solve( !VPub( $V, pk(x) ) ▶₀ #i )
  case Setup_Verifier
  solve( !KU( sign(<'tok', did, $D, $S, sid, cnf>, ~skV) ) @ #vk.12 )
    case V_Verify_case_1
    solve( !KU( h(pk(~skH)) ) @ #vk.15 )
      case H_Present
      solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                           <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
             ) @ #vk.27 )
        case H_Present
        solve( !KU( ~sid ) @ #vk.19 )
          case V_Challenge
          solve( !KU( ~n.1 ) @ #vk.40 )
            case V_Challenge
            SOLVED // trace found
          qed
        qed
      qed
    qed
  qed
qed

lemma P1_agreement_with_honest_holder:
  all-traces
  "∀ V did pk I C sid S D ch #i #k.
    ((VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
     (HonestHolder( did, pk ) @ #k)) ⇒
    (∃ #j. (HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V did pk I C sid S D ch #i #k.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
  (HonestHolder( did, pk ) @ #k)
 ∧
  ∀ #j. (HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( St_V( $V, $H, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_2
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( h(pk(~skH)) ) @ #vk.10 )
          case H_Present
          solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                               <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                 ) @ #vk.15 )
            case c_proofGen
            solve( !KU( bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) ) @ #vk.28 )
              case Issue_To_Honest_Holder
              solve( !KU( h(<~n, $V, ~sid, $S, $D, ~ch>) ) @ #vk.29 )
                case c_h
                solve( !KU( ~n ) @ #vk.33 )
                  case V_Challenge
                  solve( !KU( ~sid ) @ #vk.37 )
                    case V_Challenge
                    solve( !KU( ~ch ) @ #vk.38 )
                      case Channel_From_Adversary
                      SOLVED // trace found
                    qed
                  qed
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma P2_injective_agreement:
  all-traces
  "∀ V did pk I C sid S D ch #i #k.
    ((VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
