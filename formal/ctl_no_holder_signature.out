              by contradiction /* from formulas */
            next
              case c_bbsSign
              by solve( !KU( ~skI ) @ #vk.24 )
            qed
          qed
        qed
      qed
    next
      case Register_Adversary_DID
      solve( !Trust( $D.1, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk), $C, $I>),
                             <'cred', h(pk), $C, $I>, h(<~n, $V, ~sid, $S, $D.1, ~ch>))
               ) @ #vk.16 )
          case H_Present
          by contradiction /* from formulas */
        next
          case c_proofGen
          solve( !KU( bbsSign(~skI, <'cred', h(pk), $C, $I>) ) @ #vk.23 )
            case Issue_After_Possession_Proof
            by contradiction /* from formulas */
          next
            case Issue_To_Honest_Holder
            by contradiction /* from formulas */
          next
            case c_bbsSign
            by solve( !KU( ~skI ) @ #vk.25 )
          qed
        qed
      qed
    qed
  qed
