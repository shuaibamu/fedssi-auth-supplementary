theory FedSSI_Auth_Control_session_reusable begin

// Function signature and definition of the equational theory E

functions: bbsSign/2, fst/1, h/1, pair/2, pk/1, proofGen/3, pverify/4,
           sign/2, snd/1, true/0, verify/3
equations:
    fst(<x.1, x.2>) = x.1,
    pverify(proofGen(bbsSign(sk, m), m, ph), pk(sk), m, ph) = true,
    snd(<x.1, x.2>) = x.2,
    verify(sign(x.1, x.2), x.1, pk(x.2)) = true









restriction Equality:
  "∀ x y #i. (Eq( x, y ) @ #i) ⇒ (x = y)"
  // safety formula

restriction UniqueDID:
  "∀ d k1 k2 #i #j.
    ((RegDID( d, k1 ) @ #i) ∧ (RegDID( d, k2 ) @ #j)) ⇒ (#i = #j)"
  // safety formula

restriction NotAdversary:
  "∀ x #i. (HonestName( x ) @ #i) ⇒ (¬(x = 'M'))"
  // safety formula

rule (modulo E) Enrol_Holder:
   [ Fr( ~skH ) ]
  --[
  HonestHolder( $H, pk(~skH) ), RegDID( $H, pk(~skH) ), HonestName( $H )
  ]->
   [ !Holder( $H, ~skH ), !Registry( $H, pk(~skH) ), Out( pk(~skH) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Register_Adversary_DID:
   [ In( <$D, k> ) ] --[ RegDID( $D, k ) ]-> [ !Registry( $D, k ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Setup_Issuer:
   [ Fr( ~skI ) ]
  --[ HonestName( $I ), HonestIssuer( $I ) ]->
   [ !IssuerKey( $I, ~skI ), !IssuerPub( $I, pk(~skI) ), Out( pk(~skI) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Admin_Trusts_Issuer:
   [ !IssuerPub( $I, pkI ) ]
  --[ Trusted( $D, $I ) ]->
   [ !Trust( $D, $I, pkI ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_To_Honest_Holder:
   [ !Holder( $H, ~skH ), !IssuerKey( $I, ~skI ) ]
  --[ Issued( $I, h(pk(~skH)), $C ) ]->
   [
   !HolderCred( $H, $I, $C, bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) ),
   Out( bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>) )
   ]

  /* has exactly the trivial AC variant */

rule (modulo E) Issue_After_Possession_Proof:
   [ !IssuerKey( $I, ~skI ), In( <pkM, sigPop> ) ]
  --[
  Eq( verify(sigPop, <'pop', $I, pkM>, pkM), true ),
  Issued( $I, h(pkM), $C )
  ]->
   [ Out( bbsSign(~skI, <'cred', h(pkM), $C, $I>) ) ]

  /*
  rule (modulo AC) Issue_After_Possession_Proof:
     [ !IssuerKey( $I, ~skI ), In( <pkM, sigPop> ) ]
