rule (modulo E) R_Verify:
   [ !VPub( $V, pkV ), In( <<'tok', did, $D, $S, sid, cnf>, sig> ) ]
  --[
  Eq( verify(sig, <'tok', did, $D, $S, sid, cnf>, pkV), true ),
  RAccept( $V, did, $D, $S, sid, cnf )
  ]->
   [ ]

  /*
  rule (modulo AC) R_Verify:
     [ !VPub( $V, pkV ), In( <<'tok', did, $D, $S, sid, cnf>, sig> ) ]
    --[ Eq( z, true ), RAccept( $V, did, $D, $S, sid, cnf ) ]->
     [ ]
    variants (modulo AC)
    1. $D    = $D.12
       $S    = $S.13
       cnf   = cnf.15
       did   = did.16
       pkV   = pkV.17
       sid   = sid.18
       sig   = sig.19
       z     = verify(sig.19, <'tok', did.16, $D.12, $S.13, sid.18, cnf.15>,
                      pkV.17)
    
    2. $D    = $D.18
       $S    = $S.19
       cnf   = cnf.21
       did   = did.22
       pkV   = pk(x.33)
       sid   = sid.24
       sig   = sign(<'tok', did.22, $D.18, $S.19, sid.24, cnf.21>, x.33)
       z     = true
  */

lemma executable_accept:
  exists-trace
  "∃ V did pk I C sid S D ch #i #j.
    (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
    (HonestHolder( did, pk ) @ #j)"
/*
guarded formula characterizing all satisfying traces:
"∃ V did pk I C sid S D ch #i #j.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
  (HonestHolder( did, pk ) @ #j)"
*/
simplify
solve( !St_V( $V, $H, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_1
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                            proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                     <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                            'cred', h(pk(~skH)), $C, $I>),
                         ~skH)
               ) @ #vk.16 )
          case H_Present
          solve( !KU( ~n ) @ #vk.24 )
            case V_Challenge
            solve( !KU( ~sid ) @ #vk.27 )
              case V_Challenge
              solve( !KU( h(pk(~skH)) ) @ #vk.16 )
                case H_Present
                solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                     <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                       ) @ #vk.21 )
                  case H_Present
                  SOLVED // trace found
                qed
              qed
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma executable_relying_party:
  exists-trace
  "∃ V did D S sid cnf #i. RAccept( V, did, D, S, sid, cnf ) @ #i"
/*
guarded formula characterizing all satisfying traces:
"∃ V did D S sid cnf #i. (RAccept( V, did, D, S, sid, cnf ) @ #i)"
*/
simplify
solve( !VPub( $V, pk(x) ) ▶₀ #i )
  case Setup_Verifier
  solve( !KU( sign(<'tok', did, $D, $S, sid, cnf>, ~skV) ) @ #vk.12 )
    case V_Verify_case_1
    solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                        proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                 <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                        'cred', h(pk(~skH)), $C, $I>),
                     ~skH)
           ) @ #vk.28 )
      case H_Present
      solve( !KU( ~sid ) @ #vk.17 )
        case V_Challenge
        solve( !KU( ~n ) @ #vk.34 )
          case V_Challenge
          solve( !KU( h(pk(~skH)) ) @ #vk.24 )
            case H_Present
            solve( !KU( proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                 <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>))
                   ) @ #vk.32 )
              case H_Present
              SOLVED // trace found
            qed
          qed
        qed
      qed
    qed
  qed
qed

lemma P1_agreement_with_honest_holder:
  all-traces
  "∀ V did pk I C sid S D ch #i #k.
    ((VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
     (HonestHolder( did, pk ) @ #k)) ⇒
    (∃ #j. (HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ∧ (#j < #i))"
/*
guarded formula characterizing all counter-examples:
"∃ V did pk I C sid S D ch #i #k.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
  (HonestHolder( did, pk ) @ #k)
 ∧
  ∀ #j. (HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ⇒ ¬(#j < #i)"
*/
simplify
solve( !St_V( $V, $H, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_1
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                            proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                     <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                            'cred', h(pk(~skH)), $C, $I>),
                         ~skH)
               ) @ #vk.16 )
          case H_Present
          by contradiction /* from formulas */
        next
          case c_sign
          by solve( !KU( ~skH ) @ #vk.22 )
        qed
      qed
    qed
  qed
next
  case V_Challenge_case_2
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                            proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                     <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                            'cred', h(pk(~skH)), $C, $I>),
                         ~skH)
               ) @ #vk.16 )
          case c_sign
          by solve( !KU( ~skH ) @ #vk.22 )
        qed
      qed
    qed
  qed
qed

lemma P2_injective_agreement:
  all-traces
  "∀ V did pk I C sid S D ch #i #k.
    ((VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
     (HonestHolder( did, pk ) @ #k)) ⇒
    (∃ #j.
      ((HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j) ∧ (#j < #i)) ∧
      (¬(∃ #i2.
          (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i2) ∧ (¬(#i2 = #i)))))"
/*
guarded formula characterizing all counter-examples:
"∃ V did pk I C sid S D ch #i #k.
  (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i) ∧
  (HonestHolder( did, pk ) @ #k)
 ∧
  ∀ #j.
   (HPresent( did, pk, V, sid, S, D, ch, I, C ) @ #j)
  ⇒
   ((¬(#j < #i)) ∨
    (∃ #i2.
      (VAccept( V, did, pk, I, C, sid, S, D, ch ) @ #i2) ∧ ¬(#i2 = #i)))"
*/
simplify
solve( !St_V( $V, $H, $S, $D, n, sid, ch ) ▶₀ #i )
  case V_Challenge_case_1
  solve( !VKey( $V, skV ) ▶₁ #i )
    case Setup_Verifier
    solve( !Registry( $H, pk(~skH) ) ▶₂ #i )
      case Enrol_Holder
      solve( !Trust( $D, $I, pk(x) ) ▶₃ #i )
        case Admin_Trusts_Issuer
        solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                            proofGen(bbsSign(~skI, <'cred', h(pk(~skH)), $C, $I>),
                                     <'cred', h(pk(~skH)), $C, $I>, h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                            'cred', h(pk(~skH)), $C, $I>),
                         ~skH)
               ) @ #vk.16 )
          case H_Present
          solve( (#i2 < #i)  ∥ (#i < #i2) )
            case case_1
            solve( !St_V( $V, $H, $S, $D, n.1, ~sid, ~ch ) ▶₀ #i2 )
              case V_Challenge
              solve( !VKey( $V, skV.1 ) ▶₁ #i2 )
                case Setup_Verifier
                solve( !Registry( $H, pk(~skH) ) ▶₂ #i2 )
                  case Enrol_Holder
                  solve( !Trust( $D, $I, pk(x) ) ▶₃ #i2 )
                    case Admin_Trusts_Issuer
                    solve( !KU( sign(h(<h(<~n, $V, ~sid, $S, $D, ~ch>), 
                                        proofGen(bbsSign(~skI.1, <'cred', h(pk(~skH)), $C, $I>),
                                                 <'cred', h(pk(~skH)), $C, $I>,
                                                 h(<~n, $V, ~sid, $S, $D, ~ch>)), 
                                        'cred', h(pk(~skH)), $C, $I>),
                                     ~skH)
                           ) @ #vk.33 )
                      case H_Present
                      solve( !KU( ~n ) @ #vk.28 )
                        case V_Challenge
                        solve( !KU( ~sid ) @ #vk.32 )
                          case V_Challenge
