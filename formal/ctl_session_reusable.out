    1. $I    = $I.9
       pkM   = pkM.11
       sigPop
             = sigPop.12
       z     = verify(sigPop.12, <'pop', $I.9, pkM.11>, pkM.11)
    
    2. $I    = $I.11
       pkM   = pk(x.19)
       sigPop
             = sign(<'pop', $I.11, pk(x.19)>, x.19)
       z     = true
  */

rule (modulo E) Setup_Verifier:
   [ Fr( ~skV ) ]
  --[ HonestName( $V ), HonestVerifier( $V ) ]->
   [ !VKey( $V, ~skV ), !VPub( $V, pk(~skV) ), Out( pk(~skV) ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_From_Honest_Holder:
   [ Fr( ~ch ), !Holder( $H, skH ) ]
  --[ ChanOpen( ~ch, $H, $P ) ]->
   [ !ChanC( ~ch, $H, $P ), !ChanS( ~ch, $P ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_From_Adversary:
   [ Fr( ~ch ) ]
  --[ ChanOpen( ~ch, 'M', $P ) ]->
   [ !ChanS( ~ch, $P ), Out( ~ch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) Channel_Endpoint_Is_Adversary:
   [ !ChanC( ch, $H, 'M' ) ] --> [ Out( ch ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_Start:
   [ !ChanC( ch, $H, $P ), !Holder( $H, skH ) ]
  --[ HStart( $H, ch, $P, $S, $D ) ]->
   [ St_H( $H, $S, $D, ch ), Out( <'req', $H, $S, $D> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) V_Challenge:
   [
   !VKey( $V, skV ), !ChanS( ch, $V ), In( <'req', did, $S, $D> ), Fr( ~n ),
   Fr( ~sid )
   ]
  --[ Challenge( $V, ~sid, ~n, ch ) ]->
   [ !St_V( $V, did, $S, $D, ~n, ~sid, ch ), Out( <'chal', ~n, $V, ~sid> ) ]

  /* has exactly the trivial AC variant */

rule (modulo E) H_Present:
   [
   St_H( $H, $S, $D, ch ), !Holder( $H, skH ),
   !HolderCred( $H, $I, $C, cred ), In( <'chal', n, Vid, sid> )
   ]
  --[ HPresent( $H, pk(skH), Vid, sid, $S, $D, ch, $I, $C ) ]->
   [
   Out( <'pres', $H, <'cred', h(pk(skH)), $C, $I>, 
         proofGen(cred, <'cred', h(pk(skH)), $C, $I>,
                  h(<n, Vid, sid, $S, $D, ch>)), 
         sign(h(<h(<n, Vid, sid, $S, $D, ch>), 
                 proofGen(cred, <'cred', h(pk(skH)), $C, $I>,
                          h(<n, Vid, sid, $S, $D, ch>)), 
                 'cred', h(pk(skH)), $C, $I>),
              skH)
        >
   )
   ]

  /* has exactly the trivial AC variant */

